# ============================================================
# 中科微光 · 工作日志平台（dailylog.vivolightsales.com）环境配置样例
# 复制为 .env 后填写。本仓库不包含生产 .env；凭证需由管理员单独配置。
# ============================================================

# ---- 服务 ----
PORT=8100
HOST=127.0.0.1
PUBLIC_BASE_URL=https://dailylog.vivolightsales.com
DATA_DIR=./data
SESSION_SECRET=请生成一段随机字符串（openssl rand -hex 32）

# ---- 钉钉（微光企业内部应用；免登 + 日报拉取 + 提醒共用） ----
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
# CorpId：钉钉开放平台首页右上角「企业信息」可查，或从旧系统 /opt/dailyreport 的环境文件拷贝
DINGTALK_CORP_ID=
# AgentId（发工作通知提醒需要）
DINGTALK_AGENT_ID=
DINGTALK_APP_ID=

# ---- DWS 个人钉钉上下文（默认开启；关闭可设为 0） ----
DWS_ENABLED=1
DWS_BIN=dws
DWS_TIMEOUT_MS=15000
DWS_AUTH_TIMEOUT_MS=900000
DWS_USERS_DIR=./data/dws-users
# 旧版试用名单（不再限制助手入口，仅供独立灰度任务兼容使用）
DWS_ASSISTANT_PILOT_USERIDS=
DWS_MAX_BUFFER_BYTES=2097152

# 对话式日报助手（开启后向全部钉钉员工开放；临时上下文密钥使用 32 字节随机 Base64/Hex）
DAILY_ASSISTANT_ENABLED=0
DAILY_ASSISTANT_PILOT_USERIDS=
DAILY_ASSISTANT_CONTEXT_DB=./data/assistant-context.sqlite
DAILY_ASSISTANT_CONTEXT_KEY=
DAILY_ASSISTANT_REFERENCE_TTL_HOURS=12
DAILY_ASSISTANT_GLOBAL_CONCURRENCY=4
DAILY_ASSISTANT_PER_USER_CONCURRENCY=3
DAILY_ASSISTANT_PREWARM_ENABLED=0
DAILY_ASSISTANT_REMINDER_ENABLED=0
DAILY_ASSISTANT_CONVERSATION_ENABLED=0
DAILY_ASSISTANT_SUBMIT_ENABLED=0
DAILY_ASSISTANT_MANAGER_OVERVIEW_ENABLED=0
DAILY_ASSISTANT_PREWARM_HOUR=16
DAILY_ASSISTANT_PREWARM_MINUTE=30
DAILY_ASSISTANT_TODAY_REMINDER_HOUR=17
DAILY_ASSISTANT_TODAY_REMINDER_MINUTE=30
DAILY_ASSISTANT_OVERDUE_REMINDER_HOUR=9
DAILY_ASSISTANT_OVERDUE_REMINDER_MINUTE=30
DAILY_ASSISTANT_BOT_SENDER_IDS=
DAILY_ASSISTANT_GROUP_OTHERS_SIGNAL_MAX_MEMBERS=20
# Agent Harness V2 默认关闭；生产模型只允许 bake-off 通过的日期快照
# V2 对话内核（单 Agent + 工具 + 结构化闸门）。按钉钉 userid 灰度，名单外用户仍走旧内核
DAILY_ASSISTANT_AGENT_V2_USERIDS=
DAILY_ASSISTANT_AGENT_V2_ENABLED=0
DAILY_ASSISTANT_PRIMARY_MODEL=qwen3.7-max-2026-06-08
DAILY_ASSISTANT_BACKUP_MODEL=qwen3.7-plus-2026-05-26
DAILY_ASSISTANT_MODEL_TIMEOUT_MS=60000
# 多源 WorkEvent 真实模型链路（独立开关，默认关闭；名单外继续使用旧候选链路）
DAILY_ASSISTANT_EVENT_FUSION_ENABLED=0
DAILY_ASSISTANT_EVENT_FUSION_PILOT_USERIDS=
DAILY_ASSISTANT_EVENT_PRIMARY_MODEL=qwen3.7-max-2026-06-08
DAILY_ASSISTANT_EVENT_BACKUP_MODEL=qwen3.7-plus-2026-05-26
DAILY_ASSISTANT_EVENT_MODEL_TIMEOUT_MS=60000
DAILY_ASSISTANT_EVENT_MAX_INPUT_TOKENS=24000
DAILY_ASSISTANT_EVENT_MAX_OUTPUT_TOKENS=5000
DAILY_ASSISTANT_EVENT_PROMPT_VERSION=event-fusion-v1
# 工作发现模式：只对名单内员工启用，扩大待确认任务线索覆盖；默认关闭
DAILY_ASSISTANT_WORK_DISCOVERY_ENABLED=0
DAILY_ASSISTANT_WORK_DISCOVERY_PILOT_USERIDS=
# 单次最多返回的待确认候选数（8-100）
DAILY_ASSISTANT_WORK_DISCOVERY_MAX_CANDIDATES=50

# ---- 角色（钉钉 userid，逗号分隔；不在列表中的内部用户默认为 emp） ----
ROLE_ADMIN_USERIDS=
# 管理员姓名精确匹配（逗号分隔；仅用于无法预先取得 userid 的内部人员）
ROLE_ADMIN_NAMES=
ROLE_EXEC_USERIDS=
ROLE_MGR_USERIDS=
ROLE_LEAD_USERIDS=
# 可查看外部账号工作日志的内部钉钉 userid（逗号分隔）
EXTERNAL_LOG_VIEWER_USERIDS=
DEPT_NAME=研发部

# ---- 本地账号默认项目（账号:项目名，多个用逗号分隔） ----
DEFAULT_PROJECT_ASSIGNMENTS=pinghu01:水锤项目,pinghu02:水锤项目

# ---- 未提交提醒（工作日 9:00 钉钉工作通知；默认关，验证后再开） ----
REMINDER_ENABLED=0
REMINDER_HOUR=9

# ---- LLM（OpenAI 兼容；主路通义 DashScope，备路 DeepSeek） ----
LLM_ENABLED=1
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_FAST_MODEL=qwen-flash
LLM_STRONG_MODEL=qwen-plus
LLM_FALLBACK_BASE_URL=https://api.deepseek.com/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_FAST_MODEL=deepseek-chat
LLM_FALLBACK_STRONG_MODEL=deepseek-chat

# ---- 日报汇总（照搬模块）----
# 配置文件从任务工作台服务器 47.243.199.153 拷贝（见部署指南第 5 步）
DAILY_REPORT_DIGEST_CONFIG_FILE=./data/daily-report-digest.config.json
# 项目组名单/缓存库（从任务工作台拷贝可保留名单；不拷则用「重新发现」重建）
WORKBENCH_SQLITE_PATH=./data/workbench/workbench.sqlite
# 页面逐人简述 LLM（沿用照搬模块的开关）
DASHSCOPE_API_KEY=
DAILY_REPORT_MORNING_LLM_MODEL=qwen-flash

# ---- 照搬模块功能开关（与原任务工作台一致，必须开） ----
DAILY_REPORT_PROJECT_VIEWS_ENABLED=1
DAILY_REPORTS_PAGE_ENABLED=1

# ---- 日报汇总清晨预热（工作日 06:45 自动拉取当天日报进缓存，早上打开秒开） ----
DAILY_REPORT_PROJECT_VIEW_PREWARM_HOUR=6
DAILY_REPORT_PROJECT_VIEW_PREWARM_MINUTE=45

# ---- 研发部门昨日项目日报（应用机器人单聊卡片） ----
DAILY_REPORT_RD_DIGEST_ENABLED=0
# 正式收件人：填写经确认的钉钉 userid，逗号分隔
DAILY_REPORT_RD_DIGEST_RECIPIENT_USERIDS=
# 钉钉实际组织节点及卡片展示名称
DAILY_REPORT_RD_DIGEST_DEPARTMENT_NAME=研发中心
DAILY_REPORT_RD_DIGEST_DISPLAY_NAME=研发部门
DAILY_REPORT_RD_DIGEST_SEND_HOUR=7
DAILY_REPORT_RD_DIGEST_SEND_MINUTE=0
